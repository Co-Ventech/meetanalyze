{
  "name": "meetanalyze-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MeetAnalyze - Full-stack Chrome Extension with Backend",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "zip": "npm run zip --prefix frontend",
    "zip:frontend": "npm run zip --prefix frontend",
    "zip:firefox": "npm run zip:firefox --prefix frontend",
    "compile:frontend": "npm run compile --prefix frontend",
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
